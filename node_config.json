{
  "nodes": [
    {
      "id": 1,
      "name": "Node1 - Motor Controller",
      "type": "motor_controller",
      "menu_items": [
        {"cmd": 1, "label": "Direction1", "uart_cmd": "CMD_DIRECTION_1", "timeout_ms": 10000},
        {"cmd": 2, "label": "Direction2", "uart_cmd": "CMD_DIRECTION_2", "timeout_ms": 5000},
        {"cmd": 3, "label": "Direction3", "uart_cmd": "CMD_DIRECTION_3", "timeout_ms": 10000},
        {"cmd": 4, "label": "Led_On", "uart_cmd": "CMD_LED_ON", "timeout_ms": 0},
        {"cmd": 5, "label": "Led_Off", "uart_cmd": "CMD_LED_OFF", "timeout_ms": 0},
        {"cmd": 6, "label": "Send_Status", "uart_cmd": "CMD_SEND_STATUS", "timeout_ms": 100},
        {"cmd": 7, "label": "Stop_System", "uart_cmd": "CMD_STOP_SYSTEM", "timeout_ms": 0},
        {"cmd": 8, "label": "Init", "uart_cmd": "CMD_INIT", "timeout_ms": 0},
        {"cmd": 9, "label": "Re-flash firmware", "uart_cmd": "CMD_REFLASH", "timeout_ms": 0},
        {"cmd": 0, "label": "Exit program", "uart_cmd": "", "timeout_ms": 0}
      ],
      "auto_read_cmd": 6,
      "auto_read_interval": 1,
      "mqtt_topic": "node1_data",
      "data_structure": "node1_data_t",
      "reflash_script": "bash -c 'source ../../../esptool-env/bin/activate && esptool --chip esp32 --port /dev/ttyUSB0 write-flash 0x10000 ../dcs-test.bin && deactivate'"
    },
    {
      "id": 2,
      "name": "Node2 - Sensor Board", 
      "type": "sensor_board",
