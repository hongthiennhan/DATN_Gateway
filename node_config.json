        {"cmd": 4, "label": "Re-flash firmware", "uart_cmd": "CMD_REFLASH", "timeout_ms": 0},
        {"cmd": 0, "label": "Exit", "uart_cmd": "", "timeout_ms": 0}
      ],
      "auto_read_cmd": 3,
      "auto_read_interval": 1,
      "mqtt_topic": "node2_data",
      "data_structure": "node2_data_t",
